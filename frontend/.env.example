# FastAPI backend URL.
VITE_API_BASE=https://trace-loop.onrender.com

# Optional public Passport ID used by the hero's single-passport demo link.
VITE_DEMO_PASSPORT_ID=

# Optional comma-separated allow-list of public Passport IDs for virtual demo devices.
# The homepage counts only confirmed transaction hashes returned by each public passport
# endpoint. Use only virtual-device Passports on Algorand TestNet; do not add production IDs.
# Up to 10 IDs are loaded. A single VITE_DEMO_PASSPORT_ID is used as a fallback if this is empty.
VITE_DEMO_PASSPORT_IDS=

# Required before the homepage presents activity with TestNet labels and TestNet explorer links.
# Set only when VITE_API_BASE points to the intended TestNet-backed TraceLoop API.
VITE_DEMO_NETWORK=TESTNET
